{
  "name": "poly-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i frontend/src/styles/app.css -o static/css/app.css --minify && tailwindcss -i frontend/src/styles/poly-theme.css -o static/css/poly-theme.css --minify",
    "watch:css": "tailwindcss -i frontend/src/styles/app.css -o static/css/app.css --watch",
    "build:js": "vite build",
    "watch:js": "vite build --watch --mode development",
    "build": "npm run typecheck && npm run build:css && npm run build:js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@salusoft89/planegcs": "^1.3.0",
    "qrcode-generator": "^2.0.4",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.186.1",
    "three-gpu-pathtracer": "^0.0.27",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
