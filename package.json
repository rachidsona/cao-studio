{
  "name": "cao-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i frontend/src/styles/app.css -o static/css/app.css --minify",
    "watch:css": "tailwindcss -i frontend/src/styles/app.css -o static/css/app.css --watch",
    "build:js": "vite build",
    "watch:js": "vite build --watch --mode development",
    "build": "npm run typecheck && npm run build:css && npm run build:js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:py": ".venv/bin/pytest -q",
    "test:e2e": "playwright test",
    "test:e2e:rapide": "playwright test --grep @rapide",
    "test:rapide": "npm run build && vitest run && npm run test:py && playwright test --grep @rapide",
    "test:tout": "npm run build && vitest run && npm run test:py && playwright test"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@salusoft89/planegcs": "^1.3.0",
    "qrcode-generator": "^2.0.4",
    "replicad": "^1.2.1",
    "replicad-opencascadejs": "^1.2.1",
    "three": "^0.187.0",
    "three-gpu-pathtracer": "^0.0.28",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@playwright/test": "1.65",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
